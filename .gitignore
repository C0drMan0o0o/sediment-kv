CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
install_manifest.txt
compile_commands.json

# --- Compiled objects and binaries ---
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.gch
*.pch
*.dSYM/

# --- IDEs and editors ---
.idea/
.vscode/
.vs/
*.swp
*~
.cache/
.clangd/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Profiling, coverage and debugging ---
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov
coverage/
perf.data
perf.data.old
*.svg.tmp
