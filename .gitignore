core
core.*
vgcore.*
*.log

# --- Fuzzing ---
fuzz/corpus-tmp/
crash-*
leak-*
timeout-*
oom-*

# --- Database files created by tests and benchmarks ---
# Never commit generated data: it can be huge and breaks clones.
testdb/
tmp/
*.sst
*.wal
MANIFEST-*
CURRENT
LOCK

# --- Benchmark baselines built from source ---
bench/baseline/leveldb/
bench/baseline/rocksdb/
bench/results/raw/

# --- Keep these tracked (commit results and graphs) ---
# bench/results/*.csv and bench/results/*.png should be committed.